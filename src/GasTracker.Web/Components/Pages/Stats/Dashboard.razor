@page "/stats"
@layout MainLayout
@attribute [Authorize]
@inherits UnitOfWorkComponentBase
@inject AuthenticationStateProvider AuthState
@inject FuelCalculatorService Calc
@inject UnitConversionService Units
@inject DisplayFormatter Fmt

<PageTitle>Stats — GasTracker</PageTitle>

<h2 class="h4 mb-3">Stats</h2>

@if (_loading)
{
    <LoadingSpinner />
}
else if (!_cars.Any())
{
    <div class="text-center text-muted py-4">
        <p>Add a car and some fill-ups to see stats.</p>
        <a href="/cars" class="btn btn-primary">Go to Cars</a>
    </div>
}
else
{
    <div class="mb-3">
        <select class="form-select" @bind="_selectedCarId" @bind:after="LoadLogsAsync">
            @foreach (var car in _cars)
            {
                <option value="@car.Id">@car.Name</option>
            }
        </select>
    </div>

    <div class="btn-group w-100 mb-3" role="group">
        @foreach (var r in _ranges)
        {
            <button class="btn btn-sm @(_selectedRange == r.Days ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SetRange(r.Days)">@r.Label</button>
        }
    </div>

    @if (!_logs.Any())
    {
        <div class="text-muted text-center py-3">No fill-ups in this period.</div>
    }
    else
    {
        <!-- Summary stats -->
        <div class="row g-2 mb-3">
            <div class="col-6">
                <div class="stat-badge">
                    <div class="stat-value">@_avgEfficiency</div>
                    <div class="stat-label">@_efficiencyLabel</div>
                </div>
            </div>
            <div class="col-6">
                <div class="stat-badge">
                    <div class="stat-value">@_avgCostPerDist</div>
                    <div class="stat-label">@_costLabel</div>
                </div>
            </div>
            <div class="col-6">
                <div class="stat-badge">
                    <div class="stat-value">@_totalCost</div>
                    <div class="stat-label">total spent</div>
                </div>
            </div>
            <div class="col-6">
                <div class="stat-badge">
                    <div class="stat-value">@_totalDist @_distUnit</div>
                    <div class="stat-label">total distance</div>
                </div>
            </div>
        </div>

        <h6>Fuel Efficiency (@Units.EfficiencyLabel(_costDistUnit))</h6>
        <FuelEfficiencyChart Segments="@_segments" CostDistUnit="@_costDistUnit" />

        <h6 class="mt-3">Cost per @Units.CostDistLabel(_costDistUnit)</h6>
        <CostPerDistanceChart Segments="@_segments" CostDistUnit="@_costDistUnit" CurrencySymbol="@_currencySymbol" />

        <h6 class="mt-3">Fuel price (@_currencySymbol/@(_unit == "miles" ? "gal" : "L"))</h6>
        <GasPriceChart Logs="@_logs" Unit="@_unit" CurrencySymbol="@_currencySymbol" />
    }
}

@code {
    private List<Car> _cars = [];
    private List<FuelLog> _allLogs = [];
    private List<FuelLog> _logs = [];
    private List<FuelSegment> _segments = [];
    private bool _loading = true;
    private int _userId;
    private string _unit = "km";
    private string _distUnit = "km";
    private int _statScale = 10;
    private string _costDistUnit = "10km";
    private string _currencySymbol = "kr";
    private int _selectedCarId;
    private int _selectedRange = 90;

    private string _avgEfficiency = "—";
    private string _efficiencyLabel = "L/10km";
    private string _avgCostPerDist = "—";
    private string _costLabel = "kr/10 km";
    private string _totalCost = "—";
    private string _totalDist = "—";

    private record RangeOption(string Label, int Days);
    private readonly List<RangeOption> _ranges =
    [
        new("30d", 30),
        new("90d", 90),
        new("1y", 365),
        new("All", 0)
    ];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId = int.Parse(auth.User.FindFirst("app_user_id")?.Value ?? "0");
        var user = await Uow.Users.GetByIdAsync(_userId);
        _unit = user?.PreferredUnit ?? "km";
        _distUnit = _unit == "miles" ? "mi" : "km";
        _statScale = user?.StatScale ?? 10;
        _costDistUnit = Units.BuildCostDistUnit(_unit, _statScale);
        _currencySymbol = user?.CurrencySymbol ?? "kr";
        _efficiencyLabel = Units.EfficiencyLabel(_costDistUnit);
        _costLabel = $"{_currencySymbol}/{Units.CostDistLabel(_costDistUnit)}";

        _cars = (await Uow.Cars.GetByUserIdAsync(_userId)).ToList();
        if (_cars.Any())
        {
            _selectedCarId = _cars[0].Id;
            await LoadLogsAsync();
        }
        _loading = false;
    }

    private async Task LoadLogsAsync()
    {
        if (_selectedCarId == 0) return;

        // Always load the full history: segments at the start of a date range need the
        // fill-ups before it as their anchor, otherwise the first data point is lost.
        _allLogs = (await Uow.FuelLogs.GetByCarIdAsync(_selectedCarId, _userId))
            .OrderBy(f => f.FilledAt).ToList();
        ApplyRange();
    }

    private void SetRange(int days)
    {
        _selectedRange = days;
        ApplyRange();
    }

    private void ApplyRange()
    {
        var startingOdo = _cars.FirstOrDefault(c => c.Id == _selectedCarId)?.StartingOdometer;
        DateTime? from = _selectedRange == 0 ? null : DateTime.UtcNow.AddDays(-_selectedRange);

        _logs = _allLogs.Where(f => from is null || f.FilledAt >= from).ToList();
        _segments = Calc.Segments(_allLogs, startingOdo)
            .Where(s => from is null || s.Log.FilledAt >= from)
            .ToList();
        ComputeSummary(startingOdo, from);
    }

    private void ComputeSummary(decimal? startingOdo, DateTime? from)
    {
        // Distance-weighted: total fuel / total distance, not a mean of per-fill-up ratios
        var totals = Calc.Totals(_segments);
        if (totals is { } t)
        {
            var eff = Units.LitersPerDistUnit(t.TotalLiters, t.DistanceKm, _costDistUnit)
                ?? Calc.MilesPerGallon(Units.KmToMiles(t.DistanceKm), Units.LitersToGallons(t.TotalLiters));
            _avgEfficiency = eff.HasValue ? Fmt.Num(eff.Value, 1) : "—";

            var cpk = Calc.CostPerKm(t.TotalCost, t.DistanceKm);
            _avgCostPerDist = cpk.HasValue
                ? Fmt.Currency(Units.CostPerDistUnit(cpk.Value, _costDistUnit), _currencySymbol)
                : "—";
        }
        else
        {
            _avgEfficiency = "—";
            _avgCostPerDist = "—";
        }

        _totalCost = Fmt.Currency(_logs.Sum(l => l.TotalCost), _currencySymbol);

        // Distance driven within the range: measured from the last reading before it
        // (or the car's starting odometer) to the last reading inside it.
        var before = from is null ? null : _allLogs.LastOrDefault(l => l.FilledAt < from);
        var anchorOdo = before?.OdometerReading ?? startingOdo;
        var distKmTotal = _logs.Count > 0 && anchorOdo is not null
            ? _logs.Last().OdometerReading - anchorOdo.Value
            : 0;
        _totalDist = distKmTotal > 0 ? Fmt.Num(Units.ConvertDistance(distKmTotal, _unit), 0) : "—";
    }
}
